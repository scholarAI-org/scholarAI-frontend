# Backend API origin, used only on the server: src/middleware.ts proxies
# /backend/* to it so the browser stays same-origin and the auth cookie is
# first-party. Server-only: never prefix it with NEXT_PUBLIC_.
#   Local:            the Staging backend, https://scholarai-backend-2e27.onrender.com
#   Vercel Preview:   the Staging backend, https://scholarai-backend-2e27.onrender.com
#   Vercel Production: https://scholarai-tpxy.onrender.com
BACKEND_URL=https://scholarai-backend-2e27.onrender.com

# Shared with the backend's PROXY_SHARED_SECRET of the same environment, so it
# can trust the browser IP the proxy forwards for rate limiting. Server-only:
# never NEXT_PUBLIC_, never logged. At least 32 bytes. Staging (local and
# Vercel Preview) and Production MUST use different values. Empty disables IP
# forwarding; requests still work.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
PROXY_SHARED_SECRET=

# Feature flag: enables the Student Saved Scholarships route and its nav item.
# Default: OFF. Unset or any value other than the literal string "true" leaves
# the flag disabled. Server-only — never prefix with NEXT_PUBLIC_. Flip to
# "true" only after live backend contract acceptance (Feature 006, gate 2).
# Local dev and automated tests may set it against the dev-mock backend.
SAVED_SCHOLARSHIPS_ENABLED=

# Feature flag: enables the Student Scholarship Details page route.
# Default: OFF. Unset or any value other than the literal string "true" leaves
# the flag disabled. Server-only — never prefix with NEXT_PUBLIC_.
SCHOLARSHIP_DETAILS_ENABLED=

# Feature flag: enables the Student Application Tracking route and its nav item.
# Default: OFF. Unset or any value other than the literal string "true" leaves
# the flag disabled. Server-only — never prefix with NEXT_PUBLIC_. Flip to
# "true" only after Gate 2 on staging (needs BE-02 deployed).
TRACKING_ENABLED=

# Public origin this app is served from. Used for canonical URLs, hreflang
# alternates, Open Graph images, robots.txt and the sitemap, so Production MUST
# set it to the real domain (e.g. https://scholarai.ps) or those URLs point at
# the wrong host. Not secret, but server-only: metadata is rendered on the
# server, so it needs no NEXT_PUBLIC_ prefix.
#   Local:             unset — falls back to http://localhost:3000
#   Vercel Preview:    unset — falls back to the deployment URL Vercel provides
#   Vercel Production: the real public domain
SITE_URL=

NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Feature flag: enables the Student Home page at /student and its sidebar item.
# Default: OFF. Unset or any value other than the literal string "true" leaves
# the flag disabled (/student is "not found"). Server-only — never prefix with
# NEXT_PUBLIC_. Turn it on in Production only after live verification (Feature 009).
STUDENT_HOME_ENABLED=

# Local-development ONLY: demo data for Home sections that have no backend API
# yet. Comma-separated section names: notifications,activity,recommendations.
# Default: UNSET (off). Ignored when NODE_ENV=production and when VERCEL_ENV is
# production or preview, so it can never reach a deployed environment. Server-only
# — never prefix with NEXT_PUBLIC_. Never commit a value; never set it in Vercel.
HOME_MOCK_SECTIONS=
